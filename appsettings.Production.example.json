{
  "ConnectionStrings": {
    "DefaultConnection": "__SET_FROM_SECRET_STORE__"
  },
  "Jwt": {
    "Issuer": "https://api.example.com",
    "Audience": "https://app.example.com",
    "SecretKey": "__SET_FROM_SECRET_STORE_MINIMUM_32_BYTES__",
    "ExpiryMinutes": 60
  },
  "AdminSeed": {
    "Email": "__SET_FROM_SECRET_STORE__",
    "Password": "__SET_FROM_SECRET_STORE__",
    "FullName": "System Admin"
  },
  "IdentityEmail": {
    "BaseUrl": "https://app.example.com",
    "FromAddress": "no-reply@example.com",
    "FromName": "Glinter",
    "SmtpHost": "__SET_FROM_DEPLOYMENT_CONFIGURATION__",
    "SmtpPort": 587,
    "SmtpUsername": "__SET_FROM_SECRET_STORE__",
    "SmtpPassword": "__SET_FROM_SECRET_STORE__",
    "EnableSsl": true
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.example.com"
    ]
  },
  "RequestLimits": {
    "MaxBodyBytes": 52428800
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowMinutes": 1
  },
  "Communication": {
    "RateLimiting": {
      "DirectThreadPermitLimit": 10,
      "MessagePermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "Cleanup": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "BatchSize": 500,
    "MaxBatchesPerRun": 10,
    "RevokedTokenRetentionDays": 7,
    "RefreshTokenRetentionDays": 7,
    "MfaChallengeRetentionDays": 1,
    "ReadNotificationRetentionDays": 90,
    "UnreadNotificationRetentionDays": 365,
    "AdminAuditRetentionDays": 730
  }
}
