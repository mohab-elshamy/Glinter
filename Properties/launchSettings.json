{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5160",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "GROQ_API_KEY": "PUT_YOUR_GROQ_API_KEY_HERE",
        "NEWS_API_KEY": "PUT_YOUR_NEWS_API_KEY_HERE"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "https://localhost:7209;http://localhost:5160",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "GROQ_API_KEY": "PUT_YOUR_GROQ_API_KEY_HERE",
        "NEWS_API_KEY": "PUT_YOUR_NEWS_API_KEY_HERE"
      }
    }
  }
}